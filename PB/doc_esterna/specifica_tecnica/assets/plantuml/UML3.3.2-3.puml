@startuml
!theme plain
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 60
skinparam defaultFontSize 14

title ViewToggle

top to bottom direction

class ViewToggle {
  - viewMode: ViewMode
  __
  - setViewMode(mode: ViewMode): void
}

class useEditorStore <<store>> {
  + viewMode: ViewMode
  __
  + setViewMode(mode: ViewMode): void
}

enum ViewMode {
  editor
  render
  split
}

ViewToggle --> useEditorStore
useEditorStore --> ViewMode

@enduml
