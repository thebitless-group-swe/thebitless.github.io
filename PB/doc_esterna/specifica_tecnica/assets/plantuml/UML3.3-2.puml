@startuml
!theme plain
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 50
skinparam defaultFontSize 14

title Agganci, moduli di lib/ e dipendenze esterne

' Raggruppati per catena di dipendenza, non per cartella: la cartella di
' appartenenza e' nello stereotipo di ciascun modulo. L'organizzazione per
' cartelle e' nel diagramma UML 3.3.1.

together {
  class useAiStream <<hooks/>> {
    + start<T>(fn: (signal: AbortSignal) =>\nAsyncIterable<T>): Promise<void>
    + abort(): void
    + status: 'idle' | 'streaming' |\n'done' | 'error'
  }
  class abort <<lib/>> {
    + isAbortError(err)
  }
}

together {
  class api <<lib/, facciata>> {
    sette funzioni, una per
    operazione assistita
    - stream(endpoint, body, signal)
  }
  class sse <<lib/>> {
    + parseSseStream(reader)
    + STREAM_INTERRUPTED_MESSAGE
  }
  class SseEvent <<union>> {
    { type: 'chunk', data }
    { type: 'error', message }
  }
}

together {
  class aiActions <<lib/>> {
    + AI_ACTIONS
    + getActiveText()
  }
  class AiActionDef <<type>> {
    label, source, insertMode,
    minLength, maxLength
  }
  class AiParams <<type>> {
    length?, target_language?,
    style?, hat?
  }
}

together {
  class useNotesStore <<store/>>
  class fileSystem <<lib/>> {
    + Note
    + openNoteFromFile
    + saveNoteToFile
    + renameNote
  }
  class id <<lib/>> {
    + newId()
  }
}

together {
  class editorCommands <<lib/>> {
    undici comandi di
    formattazione
  }
  class EditorView <<CodeMirror>>
}

together {
  class remarkUnderline <<lib/>> {
    + remarkUnderline()
  }
  class "react-markdown" as RM <<libreria>>
}

class useEditorStore <<store/>>
class Zustand <<libreria>>

class useTypewriter <<hooks/>> {
  + useTypewriter(streamedText: string,\nisGenerating: boolean): string
}
class utils <<lib/>> {
  + cn(...inputs)
}

useAiStream --> abort
useAiStream --> useEditorStore
api --> sse
sse --> SseEvent
aiActions --> AiActionDef
aiActions --> AiParams
aiActions --> useEditorStore
useNotesStore --> fileSystem
fileSystem --> id
editorCommands --> EditorView
remarkUnderline --> RM
useEditorStore --> Zustand
useNotesStore --> Zustand

' impaginazione: le catene senza legami con le altre scendono su una seconda fila
useTypewriter -[hidden]right- utils
abort -[hidden]down- editorCommands
editorCommands -[hidden]right- remarkUnderline
SseEvent -[hidden]down- useTypewriter

legend bottom
  Chi invoca questi moduli e' nel diagramma UML 3.3-1: AiActionDialog usa i due agganci, api e
  aiActions; EditorToolbar ed Editor usano editorCommands; Sidebar usa fileSystem e utils;
  MarkdownView usa remarkUnderline. Le firme complete sono nei diagrammi delle sottosezioni.
  ==
  useAiStream non importa api: riceve la funzione da eseguire come parametro, e il segnale di
  annullamento e' a sua volta parametro di quella funzione, cosi' resta rieseguibile da «Rigenera».
  ==
  Il middleware persist di Zustand e' applicato al solo useNotesStore: useEditorStore non e'
  persistito.
  ==
  Entrambi gli agganci sono funzioni di React e ne impiegano useState, useRef, useEffect e
  useCallback: la dipendenza non e' disegnata perche' vale anche per ogni componente.
endlegend

@enduml
