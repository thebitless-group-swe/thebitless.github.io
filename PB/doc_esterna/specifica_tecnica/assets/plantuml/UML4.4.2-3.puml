@startuml
!theme plain
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 60
skinparam defaultFontSize 14

title Rilettura dell'archivio locale all'avvio

participant Applicazione as APP
participant useEditorStore as ES
participant useNotesStore as NS
participant persist as P
participant localStorage as LS

APP -> NS : primo accesso allo store
NS -> P : creazione dello store avvolto
P -> LS : rilegge la chiave notes_persistence
LS --> P : list e currentId, se presenti
P -> NS : stato reidratato
P -> NS : onRehydrateStorage(state)

alt esiste in list una nota con id pari a currentId

  NS -> ES : loadDocument(contenuto della nota corrente)

else archivio assente, o senza nota corrispondente

  NS -> NS : ensureWelcomeNote()
  NS -> NS : loadNote(nota di benvenuto)
  NS -> P : mutazione dello store
  P -> LS : riversa list e currentId
  NS -> ES : loadDocument(CONTENUTO_BENVENUTO)

end

@enduml
