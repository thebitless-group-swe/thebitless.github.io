@startuml
!theme plain
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 60
skinparam defaultFontSize 14

title useEditorStore

' ============================================================
' USEEDITORSTORE
' ============================================================

class useEditorStore <<store>> {
  + currentText: string
  + selectedText: string
  + streamedOutput: string
  + isGenerating: boolean
  + errorMessage: string | null
  + viewMode: ViewMode
  + aiModal: AiModal
  + editorView: EditorView | null
  + lastCall: LastCall | null
  - _loadVersion: number
  - _abortController: AbortController | null
  __
  + setCurrentText(text: string): void
  + loadDocument(text: string): void
  + setSelectedText(text: string): void
  + reset(): void
  + startStreaming(): void
  + appendChunk(chunk: string): void
  + finishStreaming(): void
  + setError(msg: string): void
  + clearError(): void
  + setViewMode(mode: ViewMode): void
  + setAiModal(modal: AiModal): void
  + insertOutputIntoNote(insertMode?: 'replace' | 'append'): void
  + discardOutput(): void
  + resetPreview(): void
  + setEditorView(view: EditorView | null): void
  + abortStream(): void
  + setLastCall(call: LastCall): void
  + clearLastCall(): void
  - _setAbortController(c: AbortController | null): void
}

' ============================================================
' TIPI DI SUPPORTO
' ============================================================

enum ViewMode {
  editor
  render
  split
}

class AiModal <<type>> {
  null | AiActionId
}

class LastCall <<type>> {
  input: string
  params: AiParams
  mode?: 'prompt' | 'link'
  actionId: AiActionId
  execute(signal: AbortSignal): AsyncIterable<string>
}

class EditorView <<libreria>> {
}

' ============================================================
' RELAZIONI
' ============================================================

useEditorStore ..> ViewMode : utilizza
useEditorStore ..> AiModal : utilizza
useEditorStore ..> LastCall : utilizza
useEditorStore ..> EditorView : conserva (editorView)

legend bottom
  Selettori atomici esportati: useCurrentText, useSelectedText, useStreamedOutput,
  useIsGenerating, useErrorMessage, useViewMode, useAiModal.
  ==
  abortStream interrompe la generazione e spegne isGenerating nello stesso passo, senza attendere
  il ciclo che consuma i frammenti (R-79-F-De, R-109-F-De).
  ==
  _loadVersion distingue il caricamento di un documento dalla scrittura ordinaria, cosi' che il
  caricamento non entri nella cronologia di annullamento dell'editor. Non ha alcun ruolo nelle
  operazioni asincrone.
  ==
  LastCall serve alla rigenerazione (R-78-F-De): execute riceve il signal come parametro e non lo
  cattura, cosi' resta rieseguibile dopo un annullamento.
  ==
  Questo store non e' avvolto dal middleware persist: lo e' il solo useNotesStore.
endlegend

@enduml
