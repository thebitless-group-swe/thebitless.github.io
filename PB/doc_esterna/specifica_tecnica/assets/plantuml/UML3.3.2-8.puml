@startuml
!theme plain
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 60
skinparam defaultFontSize 14

title AiActionDialog

top to bottom direction

class AiActionDialog {
  - actionId: AiActionId | null
  - params: AiParams
  - input: string
  - mode: 'prompt' | 'link'
  - validationError: string | null
  __
  - handleGenerate(): void
  - handleAccept(): void
  - handleReject(): void
  - handleStop(): void
  - handleParamsChange(next: AiParams): void
  - handleModeChange(next: 'prompt' | 'link'): void
}

class uiReducer <<riduttore>> {
  SET_PARAMS
  SET_INPUT
  SET_MODE
  SET_VALIDATION_ERROR
  RESTORE_FROM_LAST_CALL
  RESET_DEFAULT
}

package "componenti interni al modulo" as INT {
  class PillSelector {
    + label: string
    + options: { value: T, label: string }[]
    + value: T
    + onChange: (v: T) => void
  }
  class HatSelector {
    + value: Hat | null
    + onChange: (v: Hat) => void
  }
  class GenerateSourceTabs {
    + mode: 'prompt' | 'link'
    + onChange: (m: 'prompt' | 'link') => void
  }
}

class aiActions <<module>> {
  + AI_ACTIONS: Record<AiActionId, AiActionDef>
  + getActiveText(): string
}

class AiActionDef <<type>> {
  label: string
  source: 'text' | 'prompt' | 'url'
  insertMode: 'replace' | 'append'
  minLength: number
  maxLength: number | null
}

AiActionDialog *-- uiReducer : stato locale
AiActionDialog *-- INT : contiene
AiActionDialog --> aiActions : tabella e testo attivo
aiActions --> AiActionDef : dichiara

PillSelector -[hidden]down- HatSelector
HatSelector -[hidden]down- GenerateSourceTabs
uiReducer -[hidden]down- aiActions

legend bottom
  Collaboratori descritti altrove: useEditorStore per aiModal, isGenerating, streamedOutput,
  errorMessage e lastCall e per le azioni di inserimento, scarto e azzeramento; useAiStream per
  start e abort; useTypewriter per l'anteprima progressiva; api per l'operazione scelta;
  MarkdownView per la resa dell'esito. useNotesStore non e' fra questi.
  ==
  I tre selettori sono dichiarati nel modulo della finestra e non ne sono esportati. Ogni cambio di
  parametro o di sorgente invoca resetPreview, che annulla anche l'elaborazione in corso.
  ==
  Sette voci, sei finestre: generate-link non ha una finestra propria ed e' la seconda sorgente di
  generate, scelta da GenerateSourceTabs; di quella voce la finestra usa i soli limiti di lunghezza.
  La tabella non contiene funzioni: quale operazione della facciata invocare e' deciso all'invio.
endlegend

@enduml
