@startuml
!theme plain
hide circle
skinparam classAttributeIconSize 0
skinparam componentStyle rectangle
skinparam linetype ortho

class AiActionDialog {
  - actionId: AiActionId
  - isGenerating: boolean
  - streamedOutput: string
  - errorMessage: string | null
  - displayed: string
  - params: AiParams
  - input: string
  - validationError: string | null
  - lastCall: LastCall | null
  __
  + handleGenerate(): void
  + handleAccept(): void
  + handleReject(): void
  + handleStop(): void
}

class useEditorStore {
  - aiModal: AiModal
  - isGenerating: boolean
  - streamedOutput: string
  - errorMessage: string | null
  - lastCall: LastCall | null
  __
  + setAiModal(modal: AiModal): void
  + insertOutputIntoNote(insertMode?: 'replace' | 'append'): void
  + discardOutput(): void
  + abortStream(): void
}

class useNotesStore {
  - list: Note[]
  - currentId: string | null
}

class useAiStream {
  + start<T>(fn: () => AsyncIterable<T>): Promise<void>
  + abort(): void
}

class useTypewriter {
  + useTypewriter(text: string, isGenerating: boolean): string
}

class api {
}

class aiActions {
  + AI_ACTIONS: Record<AiActionId, AiActionConfig>
  + getActiveText(): string
}

class AiActionId {
}

class AiModal {
}

class LastCall {
}

class PillSelector {
  - label: string
  - options: Option[]
  - value: T
  - onChange: (v: T) => void
  __
  + render(): JSX
}

class HatSelector {
  - value: Hat | null
  - onChange: (v: Hat) => void
  __
  + render(): JSX
}

AiActionDialog ..> useEditorStore : utilizza
AiActionDialog ..> useNotesStore : utilizza
AiActionDialog ..> useAiStream : utilizza
AiActionDialog ..> useTypewriter : utilizza
AiActionDialog ..> api : utilizza
AiActionDialog ..> aiActions : utilizza
AiActionDialog ..> AiActionId : utilizza
AiActionDialog ..> AiModal : utilizza
AiActionDialog ..> LastCall : utilizza
AiActionDialog *-- PillSelector : contiene
AiActionDialog *-- HatSelector : contiene

' collegamenti invisibili: forzano le tre classi di tipo su una riga sottostante
aiActions -[hidden]d-> AiActionId
useEditorStore -[hidden]d-> AiModal
useNotesStore -[hidden]d-> LastCall
@enduml