@startuml
!theme plain
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 60
skinparam defaultFontSize 14

title Editor

top to bottom direction

class Editor {
  - currentText: string
  - containerRef: RefObject<HTMLDivElement>
  - viewRef: RefObject<EditorView | null>
  - prevLoadVersionRef: RefObject<number>
  __
  - effetto di montaggio: crea EditorView
  - effetto su currentText: riallinea il documento
}

class useEditorStore <<store>> {
  + currentText: string
  - _loadVersion: number
  + editorView: EditorView | null
  __
  + setCurrentText(text: string): void
  + setSelectedText(text: string): void
  + setEditorView(view: EditorView | null): void
}

class EditorView <<libreria>> {
  + state: EditorState
  + dispatch(tr: Transaction): void
  + focus(): void
  + destroy(): void
}

class updateListener <<estensione>> {
  + aggiorna selectedText su selectionSet o docChanged
  + invoca setCurrentText su docChanged
  + ignora le transazioni annotate StoreSync
}

class StoreSync <<annotation>> {
  marca le transazioni originate dallo store
}

Editor --> useEditorStore : sottoscrive currentText,\nlegge _loadVersion con getState()
Editor *-- EditorView : istanzia al montaggio
EditorView *-- updateListener : contiene
updateListener --> useEditorStore : scrive currentText\ne selectedText
updateListener --> StoreSync : riconosce e ignora
Editor --> StoreSync : annota le proprie transazioni

@enduml
