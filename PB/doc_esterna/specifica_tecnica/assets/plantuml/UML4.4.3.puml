@startuml
!theme plain
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 60
skinparam defaultFontSize 14

title Provenienza dei metadati per una nota creata nel prodotto e per una importata da file

class File <<oggetto del browser>> {
  + name
  + lastModified
}

together {
  object "Note creata da createEmpty" as CREATA {
    id = newId()
    title = titolo scelto, oppure "Senza titolo"
    content = ""
    createdAt = istante della creazione
    updatedAt = rinfrescato a ogni scrittura sulla nota
  }

  object "Note composta da openNoteFromFile" as IMPORTATA {
    id = newId()
    title = nome del file, senza .md o .txt
    content = testo letto dal file
    createdAt = istante dell'importazione
    updatedAt = istante dell'importazione
  }
}

File --> IMPORTATA : name, verso title
File ..> IMPORTATA : lastModified, non letto

CREATA -[hidden]down- IMPORTATA

@enduml
