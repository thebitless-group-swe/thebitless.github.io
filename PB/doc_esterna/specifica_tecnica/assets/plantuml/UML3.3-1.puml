@startuml
!theme plain
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 65

title Componenti dell'interfaccia e store

' Le frecce continue con il rombo sono composizione (chi rende chi).
' Le frecce tratteggiate sono uso: il componente si sottoscrive a una
' porzione dello store o ne invoca un'azione. Non portano etichetta
' perche' la superficie usata da ciascun componente e' nei diagrammi
' delle singole sottosezioni.

class App {
  - viewMode: ViewMode
}

together {
  class Sidebar {
    - collapsed: boolean
    - creating: boolean
    - newTitle: string
    - editingId: string | null
    - editingTitle: string
    - deletingId: string | null
    - fileError: string | null
  }

  class TopBar {
    + noteTitle?: string
    - isGenerating: boolean
    - errorMessage: string | null
    - aiModal: AiModal
    - currentNote: Note | null
  }

  class ViewToggle {
    - viewMode: ViewMode
  }

  class EditorToolbar {
  }
}

together {
  class Editor {
    - currentText: string
    - containerRef: RefObject<HTMLDivElement>
    - viewRef: RefObject<EditorView | null>
    - prevLoadVersionRef: RefObject<number>
  }

  class Preview {
    - currentText: string
  }

  class AiActionDialog {
    - actionId: AiActionId | null
    - params: AiParams
    - input: string
    - mode: 'prompt' | 'link'
    - validationError: string | null
    - displayed: string
  }
}

class MarkdownView {
  + children: string
  + className?: string
}

package "selettori interni ad AiActionDialog" as INT {
  class PillSelector
  class HatSelector
  class GenerateSourceTabs
}

class useEditorStore <<store>> {
  + currentText: string
  + selectedText: string
  + streamedOutput: string
  + isGenerating: boolean
  + errorMessage: string | null
  + viewMode: ViewMode
  + aiModal: AiModal
  + editorView: EditorView | null
  + lastCall: LastCall | null
  - _loadVersion: number
  - _abortController: AbortController | null
  __
  + setCurrentText(text)
  + loadDocument(text)
  + setSelectedText(text)
  + reset()
  + startStreaming()
  + appendChunk(chunk)
  + finishStreaming()
  + setError(msg)
  + clearError()
  + setViewMode(mode)
  + setAiModal(modal)
  + insertOutputIntoNote(insertMode?)
  + discardOutput()
  + resetPreview()
  + setEditorView(view)
  + abortStream()
  + setLastCall(call)
  + clearLastCall()
}

class useNotesStore <<store>> {
  + list: Note[]
  + currentId: string | null
  __
  + createEmpty(title?)
  + select(id)
  + updateCurrent(patch)
  + deleteNote(id)
  + loadNote(note)
  + ensureWelcomeNote()
}

class Note <<entity>> {
  + id: string
  + title: string
  + content: string
  + createdAt: number
  + updatedAt: number
}

class LastCall <<type>> {
  input: string
  params: AiParams
  mode?: 'prompt' | 'link'
  actionId: AiActionId
  execute(signal: AbortSignal): AsyncIterable<string>
}

' --- composizione ---
App *-- Sidebar
App *-- TopBar
App *-- ViewToggle
App *-- EditorToolbar
App *-- Editor
App *-- Preview
App *-- AiActionDialog
Preview *-- MarkdownView
AiActionDialog *-- MarkdownView
AiActionDialog *-- INT

' --- uso degli store ---
App ..> useEditorStore
Sidebar ..> useEditorStore
TopBar ..> useEditorStore
ViewToggle ..> useEditorStore
EditorToolbar ..> useEditorStore
Editor ..> useEditorStore
Preview ..> useEditorStore
AiActionDialog ..> useEditorStore
Sidebar ..> useNotesStore
TopBar ..> useNotesStore

' --- tipi ---
useNotesStore "1" o-- "0..*" Note
useEditorStore ..> LastCall

legend bottom
  Rombo pieno: composizione, cioe' quale componente rende quale altro.
  Tratteggio: uso di uno store, per sottoscrizione a una porzione o per invocazione di un'azione.
  ==
  App non passa alcuna proprieta' ai propri figli: ciascuno dichiara da se' la porzione che gli serve.
  MarkdownView e i tre selettori interni sono i soli componenti che non conoscano alcuno store.
  AiActionDialog non usa useNotesStore.
endlegend

@enduml
