@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontSize 14

title Scenario 2: caricamento di una nota (Store verso Editor)

start
:useNotesStore invoca loadDocument
con il contenuto della nota;

if (useEditorStore: il testo coincide con currentText?) then (si)
  :nessuna modifica, _loadVersion non avanza;
  stop
endif

:currentText = contenuto, _loadVersion++,
e notifica del solo currentText ai sottoscrittori
del selettore useCurrentText;

if (Editor: il documento coincide con currentText?) then (si)
  :invoca focus sull'istanza, nessuna transazione;
  stop
endif

:legge _loadVersion con getState()
e lo confronta con prevLoadVersionRef;
if (il contatore e' cambiato?) then (si)
  :transazione annotata StoreSync
  e addToHistory(false);
else (no)
  :transazione annotata
  con il solo StoreSync;
endif

:invia la transazione, e l'EditorView
sostituisce l'intero documento;
:l'updateListener riconosce StoreSync e non rimanda
nulla allo store; l'Editor invoca focus sull'istanza;
stop

@enduml
