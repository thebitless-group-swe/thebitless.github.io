@startuml
!theme plain
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 60
skinparam defaultFontSize 14

title useNotesStore

top to bottom direction

class persist <<middleware>> {
  chiave: 'notes_persistence'
  nessun partialize
  + onRehydrateStorage()
}

class useNotesStore <<store>> {
  + list: Note[]
  + currentId: string | null
  __
  + createEmpty(title?: string): Note
  + select(id: string): void
  + updateCurrent(patch: Partial<Pick<Note, 'title' | 'content'>>): void
  + deleteNote(id: string): void
  + loadNote(note: Omit<Note, 'createdAt' | 'updatedAt'>): void
  + ensureWelcomeNote(): void
}

class Note <<entity>> {
  + id: string
  + title: string
  + content: string
  + createdAt: number
  + updatedAt: number
}

class useEditorStore <<store>> {
  + currentText: string
  __
  + loadDocument(text: string): void
}

class fileSystem <<module>> {
  + Note
}

class id <<module>> {
  + newId(): string
}

persist --* useNotesStore
useNotesStore "1" o-- "0..*" Note
useNotesStore --> useEditorStore
useNotesStore --> fileSystem
useNotesStore --> id
persist --> useEditorStore

Note -[hidden]right- useEditorStore
fileSystem -[hidden]right- id

legend bottom
  Selettori esportati: useNotesList e useCurrentNote.
  ==
  createEmpty e deleteNote fotografano list e currentId prima di modificarli e li ripristinano
  se la scrittura fallisce (R-84-F-Ob, R-93-F-De).
  ==
  Il middleware persist non riceve alcun partialize: viene scritto quanto sopravvive alla
  serializzazione, cioe' list e currentId, a ogni modifica dello store. Alla rilettura carica
  nell'editor la nota corrente e, se non ce n'e' alcuna, invoca ensureWelcomeNote.
  ==
  Il testo in lavorazione non e' qui: vi giunge da useEditorStore al cambio di nota e alla
  creazione di una nuova nota, non a ogni modifica del testo.
endlegend

@enduml
