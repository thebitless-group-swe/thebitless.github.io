@startuml
!theme plain
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 60
skinparam defaultFontSize 14

title Sidebar

top to bottom direction

class Sidebar {
  - collapsed: boolean
  - creating: boolean
  - newTitle: string
  - editingId: string | null
  - editingTitle: string
  - deletingId: string | null
  - fileError: string | null
  __
  - startCreate(): void
  - commitCreate(): void
  - cancelCreate(): void
  - handleSelect(id: string): void
  - startRename(note: Note): void
  - commitRename(note: Note): Promise<void>
  - confirmDelete(id: string): void
  - handleOpenFile(): Promise<void>
  - handleSaveFile(): Promise<void>
}

class useNotesStore <<store>> {
  + list: Note[]
  + currentId: string | null
  __
  + createEmpty(title?: string): Note
  + select(id: string): void
  + updateCurrent(patch): void
  + deleteNote(id: string): void
  + loadNote(note): void
}

class useEditorStore <<store>> {
  + currentText: string
}

class fileSystem <<module>> {
  + openNoteFromFile(): Promise<Note | null>
  + saveNoteToFile(note: Note): Promise<void>
  + renameNote(note: Note, name: string): Promise<Note>
}

class Note <<entity>> {
  + id: string
  + title: string
  + content: string
  + createdAt: number
  + updatedAt: number
}

Sidebar --> useNotesStore
Sidebar --> useEditorStore
Sidebar --> fileSystem
useNotesStore "1" o-- "0..*" Note
fileSystem --> Note

useEditorStore -[hidden]right- fileSystem

@enduml
