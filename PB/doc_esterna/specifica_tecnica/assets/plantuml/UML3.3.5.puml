@startuml
!theme plain
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontSize 14
skinparam nodesep 45
skinparam ranksep 65

title Accesso al servizio applicativo

top to bottom direction

class AiActionDialog {
  - handleGenerate(): void
  - handleStop(): void
}

class TopBar {
  - handleAbort(): void
}

class useAiStream <<aggancio>> {
  + start<T>(fn: (signal: AbortSignal) => AsyncIterable<T>): Promise<void>
  + abort(): void
  + status: 'idle' | 'streaming' | 'done' | 'error'
  - abortControllerRef: RefObject<AbortController | null>
  - isAbortedRef: RefObject<boolean>
}

class useEditorStore <<store>> {
  + streamedOutput: string
  + isGenerating: boolean
  + errorMessage: string | null
  __
  + startStreaming()
  + appendChunk(chunk)
  + finishStreaming()
  + setError(msg)
  + abortStream()
  - _abortController: AbortController | null
  - _setAbortController(c)
}

class api <<facciata>> {
  + summarize(text: string, length: Length, signal?: AbortSignal)
  + translate(text: string, target_language: Language, signal?: AbortSignal)
  + rewrite(text: string, style: Style, signal?: AbortSignal)
  + grammar(text: string, signal?: AbortSignal)
  + critique(text: string, hat: Hat, signal?: AbortSignal)
  + generate(prompt: string, length: Length, signal?: AbortSignal)
  + generateFromLink(url: string, length: Length, signal?: AbortSignal)
  - stream(endpoint: string, body: unknown, signal?: AbortSignal)
}

class sse <<module>> {
  + parseSseStream(reader): AsyncIterable<SseEvent>
  + STREAM_INTERRUPTED_MESSAGE: string
  - parseField(line)
}

class SseEvent <<union>> {
  { type: 'chunk', data: string }
  { type: 'error', message: string }
}

class models <<barrel>> {
  + Length, Language, Style, Hat
  + NO_ERRORS_MARKER
}

class abort <<module>> {
  + isAbortError(err)
}

AiActionDialog --> useAiStream
AiActionDialog --> api
TopBar --> useEditorStore
useAiStream --> useEditorStore
useAiStream --> abort
api --> sse
api --> models
sse --> SseEvent

' vincoli di impaginazione
useAiStream -[hidden]right- api
useEditorStore -[hidden]right- sse
sse -[hidden]right- models

legend bottom
  Tutte le funzioni della facciata restituiscono una sequenza asincrona di frammenti testuali.
  ==
  useAiStream non importa api: riceve la funzione da eseguire come parametro, e il segnale di
  annullamento e' a sua volta parametro di quella funzione, cosi' resta rieseguibile da «Rigenera».
  Riconosce l'annullamento per nome dell'errore e in quel caso non scrive alcun messaggio (R-110-F-Ob).
  Il suo status non e' letto da alcun componente: l'attesa e' governata da isGenerating.
  ==
  Il controllore di annullamento e' tenuto in due luoghi, il riferimento interno all'aggancio e la
  porzione dello store. La finestra di dialogo usa il primo, la barra superiore il secondo. Entrambe
  le vie attivano lo stesso controllore, e il ciclo che consuma i frammenti ne verifica lo stato a
  ogni giro (R-79-F-De, UC71).
  ==
  api controlla lo stato della risposta prima di leggerne il corpo, cosi' un esito negativo resta un
  errore ordinario. Il messaggio proviene dal campo detail del servizio applicativo, e il segnale
  viene inoltrato alla richiesta di rete.
endlegend

@enduml
