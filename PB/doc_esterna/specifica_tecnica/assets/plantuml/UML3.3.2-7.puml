@startuml
!theme plain
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 60
skinparam defaultFontSize 14

title MarkdownView

top to bottom direction

class MarkdownView {
  + children: string
  + className?: string
}

class Preview {
}

class AiActionDialog {
}

class ReactMarkdown <<libreria>> {
}

class remarkGfm <<estensione>> {
}

class remarkMath <<estensione>> {
}

class remarkUnderline <<estensione del gruppo>> {
  + remarkUnderline(): Plugin
}

class rehypeKatex <<estensione>> {
}

class rehypeHighlight <<estensione>> {
}

Preview --> MarkdownView
AiActionDialog --> MarkdownView
MarkdownView *-- ReactMarkdown : compone
ReactMarkdown --> remarkGfm : remarkPlugins
ReactMarkdown --> remarkMath : remarkPlugins
ReactMarkdown --> remarkUnderline : remarkPlugins
ReactMarkdown --> rehypeKatex : rehypePlugins
ReactMarkdown --> rehypeHighlight : rehypePlugins

legend bottom
  Unico punto dell'applicazione web in cui il Markdown viene reso, condiviso dal pannello di
  anteprima e dall'anteprima dell'esito nella finestra di dialogo: e' la ragione per cui i due
  contesti non possono divergere.
  ==
  In nessun punto della pipeline l'HTML grezzo e' abilitato. remarkUnderline e' l'unica estensione
  scritta dal gruppo e dichiara l'elemento da produrre anziche' emettere marcatura.
endlegend

@enduml
