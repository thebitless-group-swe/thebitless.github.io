@startuml
!theme plain
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 60
skinparam defaultFontSize 14

title La catena di persistenza dello store delle note

together {
  class useEditorStore <<store/>> {
    + currentText: string
    + loadDocument(text: string): void
    + setCurrentText(text: string): void
    + insertOutputIntoNote(insertMode?): void
  }

  class useNotesStore <<store/>> {
    - list: Note[]
    - currentId: string | null
    + createEmpty(title?: string): Note
    + select(id: string): void
    + updateCurrent(patch): void
    + deleteNote(id: string): void
    + loadNote(note: Note): void
    + ensureWelcomeNote(): void
  }

  class Note <<lib/fileSystem.ts>> {
    + id: string
    + title: string
    + content: string
    + createdAt: number
    + updatedAt: number
  }
}

together {
  class persist <<zustand/middleware>> {
    + name = "notes_persistence"
    + onRehydrateStorage()
  }

  class localStorage <<browser>> {
  }
}

useNotesStore "1" o-- "0..*" Note
useNotesStore ..> useEditorStore
useNotesStore ..> persist : avvolto da
persist ..> localStorage : serializza e rilegge

@enduml
