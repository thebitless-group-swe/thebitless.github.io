@startuml
!theme plain
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 60
skinparam defaultFontSize 14

title I momenti in cui il testo dell'editor raggiunge l'archivio locale

actor Utente as U
participant Editor as ED
participant useEditorStore as ES
participant AiActionDialog as AD
participant Sidebar as SB
participant useNotesStore as NS
participant persist as P
participant localStorage as LS

== Modifica del testo, che si ferma a useEditorStore ==

U -> ED : digita nella nota corrente
ED -> ES : setCurrentText(testo)
ES --> ED : currentText aggiornato

== Accettazione di un esito assistito, che si ferma a useEditorStore ==

U -> AD : accetta l'esito
AD -> ES : insertOutputIntoNote(insertMode)
ES -> ES : currentText, streamedOutput, aiModal
ES --> ED : currentText aggiornato

== Cambio di nota, prima transizione che scrive ==

U -> SB : sceglie un'altra nota
SB -> NS : select(id)
NS -> ES : legge currentText
ES --> NS : testo in lavorazione
NS -> NS : il testo entra nella nota abbandonata
NS -> P : mutazione dello store
P -> LS : riversa list e currentId
NS -> ES : loadDocument(contenuto della nota scelta)

== Creazione di una nota, seconda transizione che scrive ==

U -> SB : conferma "Nuova nota"
SB -> NS : createEmpty(titolo)
NS -> ES : legge currentText
ES --> NS : testo in lavorazione
NS -> NS : il testo entra nella nota precedente
NS -> NS : la nuova nota entra in list
NS -> P : mutazione dello store
P -> LS : riversa list e currentId
NS -> ES : loadDocument("")

@enduml
