@startuml
!theme plain
hide circle
hide empty members
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 45
skinparam defaultFontSize 14

title Organizzazione per ruolo di web/src

class "radice di web/src" as ROOT {
  main.tsx, monta l'applicazione nel DOM
  App.tsx, radice dell'albero e layout
  index.css, stile globale e temi
}

class "components/" as COMP {
  Sidebar, TopBar, ViewToggle, EditorToolbar,
  Editor, Preview, MarkdownView, AiActionDialog
  ..
  ui/ : alert, button, textarea
}

class "hooks/" as HOOKS {
  useAiStream, useTypewriter
}

class "store/" as STORE {
  useEditorStore, useNotesStore
}

class "lib/" as LIB {
  api, sse, fileSystem, id, editorCommands,
  aiActions, remarkUnderline, abort, utils
}

class "types/" as TYPES {
  api.ts, generato da openapi-typescript
  models.ts, barrel di re-export
}

class "test/" as TEST {
  setup.ts, configurazione comune
}

class "assets/" as ASSETS {
  risorse statiche
}

ROOT --> COMP
COMP --> HOOKS
COMP --> STORE
COMP --> LIB
COMP --> TYPES
HOOKS --> STORE
HOOKS --> LIB
STORE --> LIB
LIB --> STORE
LIB --> TYPES

TEST -[hidden]right- ASSETS
TYPES -[hidden]down- TEST

legend bottom
  Le frecce indicano la direzione delle importazioni. test/ e assets/ non ne hanno alcuna verso
  le altre cartelle.
  ==
  Fra lib/ e store/ la dipendenza corre nei due sensi: useNotesStore importa fileSystem e id,
  mentre aiActions importa useEditorStore e useEditorStore importa da aiActions il tipo AiParams.
  Queste ultime due formano un ciclo fra due file che non sopravvive alla compilazione, perche'
  la seconda e' un'importazione di soli tipi. Nessuna cartella importa components/.
  ==
  In types/ soltanto models.ts importa il file generato: il resto dell'applicazione passa da models.ts.
  I casi di prova non risiedono in test/, che contiene la sola configurazione comune: ciascun caso
  di prova sta accanto al modulo che esercita.
endlegend

@enduml
