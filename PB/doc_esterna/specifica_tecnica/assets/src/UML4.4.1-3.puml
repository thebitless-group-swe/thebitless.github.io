@startuml
!theme plain
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 60
skinparam defaultFontSize 14

title Caricamento di una nota da file

start

:L'utente attiva "Apri file..."
nella Sidebar;

:handleOpenFile chiama openNoteFromFile;

if (showOpenFilePicker presente in window?) then (si)

  :showOpenFilePicker
  con i tipi .md e .txt;

  switch (esito della chiamata nativa?)
  case (riuscita)
    :getFile e file.text danno
    il testo e il nome;
  case ( AbortError)
    :eAnnullamento riconosce
    l'annullamento, il risultato
    e' null;
    stop
  case (altro errore)
    :L'errore risale alla Sidebar,
    che mostra un messaggio
    e preserva la sessione;
    stop
  endswitch

else (no)

  :scegliFileConInput crea un input
  di tipo file con le estensioni
  ammesse e lo attiva;

  switch (segnale che arriva prima?)
  case (change con un file)
    :FileReader.readAsText da'
    il testo e il nome;
  case ( oncancel)
    :Il risultato e' null;
    stop
  case (fuoco tornato)
    :Trascorsi
    GRAZIA_ANNULLAMENTO_MS
    input.files e' ancora
    vuoto, il risultato e' null;
    stop
  endswitch

endif

:title dal nome del file, senza .md o .txt,
oppure TITOLO_DI_RIPIEGO se il nome manca;

:id da newId, createdAt e updatedAt
all'istante di importazione;

:openNoteFromFile restituisce la Note;

:La Sidebar la passa a loadNote di useNotesStore,
che la rende corrente e ne carica il testo nell'editor
senza consolidare prima il testo in lavorazione;

stop

@enduml
